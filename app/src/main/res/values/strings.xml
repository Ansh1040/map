    <!-- Privacy policy (in-app summary; TODO: host the full policy and set PRIVACY_POLICY_URL) -->
    <string name="privacy_full_online">Read the full policy online</string>
    <string name="privacy_h_summary">Summary</string>
    <string name="privacy_p_summary">Drive Alert treats your location as sensitive personal data. It uses location only to warn you about traffic cameras during a drive you start, processes it on your phone, and never sells it or uses it for advertising.</string>
    <string name="privacy_h_location">Location</string>
    <string name="privacy_p_location">When you press Start Drive, Drive Alert uses precise location until you stop alerts, the drive ends, or 30 minutes pass without movement. This includes while other apps such as Google Maps are on screen and while the phone is locked. A notification is shown the whole time. When alerts are off, Drive Alert does not track your location.</string>
    <string name="privacy_h_on_device">On your phone</string>
    <string name="privacy_p_on_device">Camera matching happens on the phone using the downloaded camera database. Alert history (which camera was announced and when, without your coordinates) and your settings are stored only on the phone and are excluded from cloud backup.</string>
    <string name="privacy_h_server">Server communication</string>
    <string name="privacy_p_server">Over encrypted HTTPS, Drive Alert downloads camera data packages for the cities and states you choose. These requests contain only the package name and data version, never your location or trips.</string>
    <string name="privacy_h_reports">Camera reports</string>
    <string name="privacy_p_reports">If you submit a camera report, the report details and the single location you attached are sent to the moderation service. Reports are reviewed before they affect alerts.</string>
    <string name="privacy_h_never">What Drive Alert never does</string>
    <string name="privacy_p_never">Drive Alert does not upload trip history, does not sell or share location data, does not show ads, does not read your Google Maps route or other apps’ screens, and does not log precise coordinates in production builds.</string>
    <string name="privacy_h_retention">Retention</string>
    <string name="privacy_p_retention">Alert history older than 30 days is deleted automatically. You can delete all local history at any time in Settings.</string>
    <string name="privacy_h_choices">Your choices</string>
    <string name="privacy_p_choices">You can stop alerts at any time, revoke location or notification permission in Android settings, delete local history, or uninstall the app to remove all data stored on the phone.</string>
    <string name="privacy_h_contact">Contact</string>
    <string name="privacy_p_contact">TODO before release: add the data controller’s name and grievance contact, as required under India’s Digital Personal Data Protection Act, 2023.</string>
