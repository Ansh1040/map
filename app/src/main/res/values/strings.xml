    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Welcome to Drive Alert</string>
    <string name="onboarding_welcome_body">Timely voice and on-screen warnings before verified speed, red-light and traffic enforcement cameras, to help you keep to the speed limit.</string>
    <string name="onboarding_maps_title">Works alongside Google Maps</string>
    <string name="onboarding_maps_body">Drive Alert runs next to Google Maps but works independently. It cannot see your Google Maps route or destination, and it never reads other apps’ screens.</string>
    <string name="onboarding_maps_point_1">Warnings are based on your position, direction of travel and speed.</string>
    <string name="onboarding_maps_point_2">Cameras behind you or on the opposite carriageway are filtered out when the data allows it.</string>
    <string name="onboarding_maps_point_3">Warnings appear as a normal Android notification and a voice prompt over any app.</string>
    <string name="onboarding_safety_title">Drive within the limit</string>
    <string name="onboarding_safety_body">Drive Alert supports speed-limit compliance. It is not a way to avoid penalties.</string>
    <string name="onboarding_safety_point_1">Camera data may be incomplete or outdated. Not every camera is included.</string>
    <string name="onboarding_safety_point_2">Always follow posted speed limits and road signs, with or without a warning.</string>
    <string name="onboarding_safety_point_3">Set everything up before you drive. Never use the phone while driving.</string>
    <string name="onboarding_notifications_title">Allow warnings on screen</string>
    <string name="onboarding_notifications_body">Notifications let Drive Alert show camera warnings over Google Maps and keep a visible “Camera alerts active” notification with a Stop button.</string>
    <string name="onboarding_done_title">You are ready</string>
    <string name="onboarding_done_body">The setup assistant checks battery settings that can delay alerts on some phones, including OnePlus. It takes about a minute.</string>

    <!-- Prominent location disclosure (shown before the system permission dialog) -->
    <string name="disclosure_title">How Drive Alert uses your location</string>
    <string name="disclosure_body">Drive Alert collects precise location data to warn you about verified traffic cameras ahead. While camera alerts are on, location is used even when Drive Alert is closed or not in use, for example while Google Maps is on screen or the phone is locked. Location is only used after you press Start Drive, and stops when the drive ends.</string>
    <string name="disclosure_point_1">Camera checks happen on your phone. Your location and trips are not uploaded.</string>
    <string name="disclosure_point_2">Location is never sold, shared with advertisers or used for ads.</string>
    <string name="disclosure_point_3">A notification is always shown while alerts are on, with a Stop button.</string>
    <string name="disclosure_point_4">Only camera reports you choose to send include a location.</string>

